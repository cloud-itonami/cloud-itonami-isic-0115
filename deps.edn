{:paths ["src"]
 ;; langgraph brings langchain transitively (both zero-/single-dep,
 ;; all .cljc -> portable to JVM / SCI / ClojureScript / GraalVM). It lives
 ;; in the kotoba-lang org of this workspace (transferred + renamed from
 ;; com-junkawasaki/langgraph-clj / com-junkawasaki/langchain-clj).
 ;;
 ;; This tobacco-growing vertical is SELF-CONTAINED: there is no
 ;; `kotoba-lang/tobacco-growing` to delegate field-registration /
 ;; cost-threshold / closed-op-allowlist checks to, so those pure functions
 ;; live in `tobaccoops.registry` / `tobaccoops.facts` rather than wrapping
 ;; an external lib. This repo is standalone (forkable outside the
 ;; workspace); the :local/root paths only resolve inside the monorepo
 ;; checkout -- a standalone fork should override them with git
 ;; coordinates.
 ;;
 ;; FIX (deferred-stub bug): `langgraph` used to be declared ONLY under the
 ;; :dev :override-deps alias. :override-deps only *overrides an existing
 ;; :deps entry* -- with an empty :deps map it never added langgraph to the
 ;; real build/run path. `tobaccoops.operation` therefore never actually
 ;; required `langgraph.graph` and the "actor" was a synchronous stub
 ;; pretending to run a StateGraph (see its old docstring, now removed).
 ;; `langgraph` and `langchain-store` (the shared store seam -- EDN-blob
 ;; codec + identity schema + event-log helpers, ADR-2607141600) now live
 ;; in the real :deps map, same shape as cloud-itonami-isic-0111
 ;; (cerealops) / cloud-itonami-isic-869 (transportops).
 :deps {io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}
        io.github.kotoba-lang/langchain-store
        {:local/root "../../kotoba-lang/langchain-store"}}
 :aliases
 {;; offline workspace dev -- pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; clojure -M:dev:run  -> drive the demo through one OperationActor
  :run {:main-opts ["-m" "tobaccoops.sim"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  ;; static analysis -- clj-kondo from deps (no binary), errors fail CI.
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
